QUANTUMSHIELD_ENV=development
QUANTUMSHIELD_HOST=0.0.0.0
QUANTUMSHIELD_PORT=8000
QUANTUMSHIELD_DATA_DIR=./data
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a securely managed secret in real deployments. Never commit the value.
QUANTUMSHIELD_MASTER_KEY=
QUANTUMSHIELD_MAX_UPLOAD_BYTES=10485760
QUANTUMSHIELD_ALLOWED_ORIGINS=http://localhost:3000
